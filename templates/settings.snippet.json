{
  "//": "Merge into the project's .claude/settings.json during /adopt. Adapt the allow list to the project's stack; keep the deny list.",
  "permissions": {
    "allow": [
      "EnterWorktree", "ExitWorktree",
      "Bash(dotnet:*)", "Bash(npm:*)", "Bash(npx:*)", "Bash(node:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)",
      "Bash(git commit:*)", "Bash(git checkout:*)", "Bash(git switch:*)", "Bash(git branch:*)",
      "Bash(git merge:*)", "Bash(git push:*)", "Bash(git pull:*)", "Bash(git fetch:*)",
      "Bash(az repos:*)", "Bash(az boards:*)", "Bash(az pipelines:*)", "Bash(az devops:*)",
      "Bash(powershell:*gate.ps1*)", "Bash(pwsh:*gate.ps1*)",
      "Bash(python:*ado_cli.py*)", "PowerShell(python:*ado_cli.py*)",
      "PowerShell(dotnet:*)", "PowerShell(npm:*)", "PowerShell(npx:*)", "PowerShell(node:*)",
      "PowerShell(git status:*)", "PowerShell(git diff:*)", "PowerShell(git log:*)",
      "PowerShell(git add:*)", "PowerShell(git commit:*)", "PowerShell(git checkout:*)",
      "PowerShell(git switch:*)", "PowerShell(git branch:*)", "PowerShell(git merge:*)",
      "PowerShell(git push:*)", "PowerShell(git pull:*)", "PowerShell(git fetch:*)",
      "PowerShell(az repos:*)", "PowerShell(az boards:*)", "PowerShell(az pipelines:*)",
      "PowerShell(az devops:*)", "PowerShell(*gate.ps1*)"
    ],
    "deny": [
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(git reset --hard:*)",
      "Bash(git clean:*)", "Bash(rm -rf:*)",
      "Bash(az boards work-item delete:*)", "Bash(az repos repository delete:*)",
      "PowerShell(git push --force:*)", "PowerShell(git push -f:*)",
      "PowerShell(git reset --hard:*)", "PowerShell(git clean:*)",
      "PowerShell(az boards work-item delete:*)", "PowerShell(az repos repository delete:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/format-changed.ps1",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .claude/hooks/stop-gate.ps1",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
